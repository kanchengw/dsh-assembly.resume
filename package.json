{
  "name": "dsh-assembly.resume",
  "description": "Import local Codex and Claude Code sessions into DSH Agent conversations",
  "version": "0.1.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bundle": "tsdown",
    "test:artifact": "node scripts/artifact-smoke.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm test:artifact"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-brand": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../deepseek-harness-latest/vendor/cordis",
    "@deepseek-ai/dsh-brand": "link:../../deepseek-harness-latest/packages/util/brand",
    "@deepseek-ai/dsh-agent": "link:../../deepseek-harness-latest/packages/core/agent",
    "@deepseek-ai/dsh-invariants": "link:../../deepseek-harness-latest/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-llm": "link:../../deepseek-harness-latest/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../deepseek-harness-latest/packages/core/session",
    "@deepseek-ai/dsh-session-persistence": "link:../../deepseek-harness-latest/packages/session/session-persistence",
    "@deepseek-ai/dsh-storage": "link:../../deepseek-harness-latest/packages/storage/storage",
    "@deepseek-ai/dsh-storage-domain": "link:../../deepseek-harness-latest/packages/storage/storage-domain",
    "@deepseek-ai/dsh-typert-protocol": "link:../../deepseek-harness-latest/packages/typert/protocol",
    "@deepseek-ai/dsh-api-remotes": "link:../../deepseek-harness-latest/packages/api/remotes",
    "@deepseek-ai/dsh-client-runtime": "link:../../deepseek-harness-latest/packages/client/runtime",
    "@deepseek-ai/dsh-client-locale": "link:../../deepseek-harness-latest/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-settings": "link:../../deepseek-harness-latest/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../deepseek-harness-latest/packages/client/ui-slots",
    "@deepseek-ai/schemastery": "link:../../deepseek-harness-latest/vendor/schemastery",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
