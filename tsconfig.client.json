    { "path": "../../deepseek-harness/packages/client/runtime" },
    { "path": "../../deepseek-harness/packages/client/locale" },
    { "path": "../../deepseek-harness/packages/client/ui-settings" },
    { "path": "../../deepseek-harness/packages/client/ui-settings-plugins" },
    { "path": "../../deepseek-harness/packages/client/ui-slots" },
    { "path": "../../deepseek-harness/packages/core/session" },
    { "path": "../../deepseek-harness/packages/typert/protocol" }
